# Copy to .env for local dev (never commit .env)

# Stripe — set in Cloudflare Pages → Settings → Environment variables
# Use matching modes: both test keys OR both live keys
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe customer receipts
# Dashboard → Settings → Customer emails → turn ON "Successful payments"
# so receipt_email on each PaymentIntent delivers a Stripe receipt.

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
# ZOOM_HOST_EMAIL=host@yourdomain.com

# Resend — transactional email (inquiries, enrollments, newsletter)
# 1. Create an API key at https://resend.com
# 2. Verify your sending domain (e.g. alerttrainingservices.com)
# 3. Set FROM_EMAIL to an address on that domain
# 4. Set ADMIN_EMAIL to where inquiry/enrollment notices should arrive
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=info@alerttrainingservices.com
ADMIN_EMAIL=info@alerttrainingservices.com
