# Copy to .env for local dev (never commit .env)

# Stripe — set in Cloudflare Pages → Settings → Environment variables
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
# ZOOM_HOST_EMAIL=host@yourdomain.com

# Formspree — admin notification after each paid enrollment
# 1. Create a form at https://formspree.io
# 2. Open the form; your URL looks like https://formspree.io/f/abc123xy
# 3. Copy only the ID after /f/ (example: abc123xy) — not the full URL
# 4. Add the same value as FORMSPREE_FORM_ID in Cloudflare (Production) and in .env locally
# Submissions appear under Formspree → [your form] → Submissions after payment succeeds.
# Optional: enable Formspree Auto-Reply on this form to email Zoom links to the student
# (Stripe sends the payment receipt separately when receipt_email is set on the PaymentIntent).
FORMSPREE_FORM_ID=your_enrollment_formspree_form_id

# Formspree — Contact Us page (separate form from enrollments)
FORMSPREE_CONTACT_FORM_ID=your_contact_formspree_form_id

# Stripe customer receipts
# Ensure Dashboard → Settings → Customer emails → "Successful payments" is ON
# so receipt_email on each PaymentIntent actually delivers a receipt.
