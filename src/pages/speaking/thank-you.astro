---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { site, routes } from "../../lib/site";
---

<BaseLayout
  title={`Thank You | Speaking Inquiry | ${site.businessName}`}
  description="Thank you for inviting Rev Judith Morgan to speak. We received your inquiry and will follow up soon."
  canonical={`${site.siteUrl}/speaking/thank-you`}
>
  <main class="ty-page">
    <section class="ty-card-wrap">
      <div class="ty-card">
        <p class="eyebrow">Speaking Inquiry Received</p>
        <h1>Thank you for reaching out</h1>
        <p>
          We received your request to invite {site.founderFormal} to speak.
          Someone from Alert Training Services will follow up soon to discuss
          your event, audience, and presentation options.
        </p>
        <p>
          If you need to reach us sooner, call
          <a href={site.phoneHref}>{site.phone}</a>
          or email
          <a href={site.emailHref}>{site.email}</a>.
        </p>
        <div class="actions">
          <a class="btn-primary" href={routes.speaking}>Back to Speaking</a>
          <a class="btn-secondary" href={routes.home}>Return Home</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ty-page {
    min-height: 70vh;
    background: #f5f5f7;
    font-family: Poppins, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .ty-card-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 72px 24px;
  }
  .ty-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 40px 32px;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: #c8102e;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 16px;
    color: #0f2744;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.2;
  }
  p {
    margin: 0 0 14px;
    color: #515154;
    line-height: 1.7;
  }
  a {
    color: #1b3a5c;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }
  .btn-primary {
    background: #c8102e;
    color: #fff;
  }
  .btn-secondary {
    border: 2px solid #1b3a5c;
    color: #1b3a5c;
  }
</style>
