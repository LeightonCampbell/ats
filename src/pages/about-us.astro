---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, routes } from "../lib/site";
---

<BaseLayout
  title={`About Judith Morgan | ${site.businessName}`}
  description={`${site.founder} is an AHA instructor and keynote speaker leading Alert Training Services, LLC — CPR, AED, emergency response training, and workplace safety presentations.`}
  canonical={`${site.siteUrl}/about-us`}
>
  <main class="about-shell" style="background:#f5f5f7; padding: 50px 24px;">
    <section style="max-width:920px; margin:0 auto;">
      <div style="text-align:center; margin-bottom:34px;">
        <div
          style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#c8102e;margin-bottom:10px;"
        >
          About Judith
        </div>
        <h1 style="font-size:2.4rem;font-weight:700;color:#0f2744;letter-spacing:-0.03em;margin-bottom:12px;">
          {site.founder} — AHA Instructor &amp; Speaker
        </h1>
        <p style="max-width:760px;margin:0 auto;color:#515154;font-size:1rem;line-height:1.7;">
          {site.legalName} equips lifesavers with official American Heart
          Association training and inspires resilient communities through
          keynote speaking and workplace safety presentations.
        </p>
      </div>

      <div style="display:grid;gap:16px;">
        <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:28px;">
          <h2 style="font-size:1.35rem;color:#0f2744;margin-bottom:10px;">Instructor &amp; presenter</h2>
          <p style="color:#515154;line-height:1.7;">
            ATS is led by {site.founder}, a Registered Nurse in California with
            decades of healthcare experience across emergency, medical surgical,
            home health, and behavioral health case management. She teaches AHA
            CPR and emergency response courses and delivers engaging keynotes
            for conferences, corporate wellness events, and healthcare organizations.
          </p>
        </article>

        <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:28px;">
          <h2 style="font-size:1.35rem;color:#0f2744;margin-bottom:10px;">What we offer</h2>
          <ul style="margin:0;padding-left:20px;color:#515154;line-height:1.8;">
            <li>
              <a href={routes.bls} style="color:#c8102e;font-weight:600;">AHA BLS Provider Training</a>
              — for healthcare providers and first responders
            </li>
            <li>
              <a href={routes.pediatric} style="color:#c8102e;font-weight:600;">AHA Heartsaver Pediatric First Aid CPR AED</a>
              — for teachers, babysitters, and caregivers
            </li>
            <li>
              <a href={routes.emsa} style="color:#c8102e;font-weight:600;">EMSA Preventive Health &amp; Safety</a>
              — evening online enrollment for California childcare providers
            </li>
            <li>
              <a href={routes.speaking} style="color:#c8102e;font-weight:600;">Keynote speaking</a>
              — safety culture and emergency preparedness presentations
            </li>
            <li>
              <a href={routes.daycareGuide} style="color:#c8102e;font-weight:600;">Home Daycare Guide</a>
              — California startup resources for family childcare homes
            </li>
          </ul>
        </article>

        <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:28px;">
          <h2 style="font-size:1.35rem;color:#0f2744;margin-bottom:10px;">Our mission</h2>
          <p style="color:#515154;line-height:1.7;">
            Deliver clear, hands-on, and practical instruction so participants
            leave certified and confident — ready to respond at work, school, or
            in the community.
          </p>
        </article>
      </div>

      <div
        style="margin-top:22px;background:#0f2744;border-radius:16px;padding:26px 24px;text-align:center;"
      >
        <h2 style="font-size:1.4rem;font-weight:700;color:white;margin-bottom:10px;">
          Ready to train or book Judith?
        </h2>
        <p style="color:rgba(255,255,255,0.8);margin-bottom:18px;">
          Call <a href={site.phoneHref} style="color:white;">{site.phone}</a> or
          email
          <a href={site.emailHref} style="color:white;">
            {site.email}
          </a>
          .
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          <a
            href={routes.courses}
            style="display:inline-block;background:#c8102e;color:white;text-decoration:none;padding:12px 28px;border-radius:8px;font-weight:700;"
          >
            Find a Class
          </a>
          <a
            href={routes.speakingInquiry}
            style="display:inline-block;background:transparent;color:white;border:2px solid rgba(255,255,255,0.55);text-decoration:none;padding:10px 26px;border-radius:8px;font-weight:700;"
          >
            Book Judith to Speak
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
