---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, routes } from "../lib/site";

const intent = Astro.url.searchParams.get("intent") ?? "";
const course = Astro.url.searchParams.get("course") ?? "";

const courseLabels: Record<string, string> = {
  bls: "AHA BLS Provider Training",
  pediatric: "AHA Heartsaver Pediatric First Aid CPR AED",
  emsa: "EMSA Preventive Health & Safety",
};

let defaultMessage = "Ask a question about class schedules, attendance rules, or registration.";
if (intent === "group") {
  defaultMessage =
    "I would like to schedule a private group / on-site training session.\n\nCompany name:\nEstimated student count:\nPreferred location:\nPreferred dates:\n";
  if (course && courseLabels[course]) {
    defaultMessage = `I would like on-site training for: ${courseLabels[course]}.\n\nCompany name:\nEstimated student count:\nPreferred location:\nPreferred dates:\n`;
  }
} else if (intent === "speaking") {
  defaultMessage =
    "I would like to inquire about booking Judith Morgan to speak.\n\nOrganization / Event:\nEvent date & location (in-person or virtual):\nEstimated audience size:\nTopic / objectives:\n";
} else if (course && courseLabels[course]) {
  defaultMessage = `I am interested in registering for: ${courseLabels[course]}.\n\nPreferred dates or questions:\n`;
}
---

<BaseLayout
  title={`Contact Us | ${site.businessName}`}
  description={`Contact ${site.legalName} for AHA CPR classes, EMSA Preventive Health & Safety enrollment, on-site group training, or speaking inquiries with ${site.founder}.`}
  canonical={`${site.siteUrl}/contact-us`}
>
  <style>
    .contact-shell section {
      padding: 0;
    }
  </style>
  <main class="contact-shell" style="background:#f5f5f7; padding: 50px 24px;">
    <section style="max-width:1080px; margin:0 auto;">
      <div style="text-align:center; margin-bottom:34px;">
        <div
          style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#c8102e;margin-bottom:10px;"
        >
          Contact Us
        </div>
        <h1 style="font-size:2.35rem;font-weight:700;color:#0f2744;letter-spacing:-0.03em;margin-bottom:12px;">
          Class, group, and speaking inquiries
        </h1>
        <p style="max-width:760px;margin:0 auto;color:#515154;font-size:1rem;line-height:1.7;">
          Reach Alert Training Services for AHA certification classes, EMSA
          Preventive Health &amp; Safety enrollment, on-site workplace training,
          or booking {site.founder} to speak.
        </p>
      </div>

      <div
        style="display:grid;grid-template-columns:1fr 1.2fr;gap:24px;align-items:start;"
      >
        <aside style="display:grid;gap:14px;">
          <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:22px;">
            <h2 style="font-size:1.1rem;color:#0f2744;margin-bottom:10px;">Get in touch</h2>
            <p style="color:#515154;line-height:1.7;margin-bottom:10px;">
              We answer calls and messages during business hours.
            </p>
            <p style="margin:0 0 6px;">
              <a href={site.phoneHref} style="color:#0f2744;font-weight:600;text-decoration:none;">
                {site.phone}
              </a>
            </p>
            <p style="margin:0;">
              <a href={site.emailHref} style="color:#0f2744;font-weight:600;text-decoration:none;">
                {site.email}
              </a>
            </p>
          </article>

          <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:22px;">
            <h2 style="font-size:1.1rem;color:#0f2744;margin-bottom:10px;">Work hours</h2>
            <p style="color:#515154;line-height:1.9;margin:0;">
              <strong>Mon - Sat:</strong> 9:00 AM - 5:00 PM<br />
              <strong>Sunday:</strong> Closed
            </p>
          </article>

          <article style="background:#0f2744;border-radius:16px;padding:22px;">
            <h2 style="font-size:1.1rem;color:white;margin-bottom:10px;">Quick links</h2>
            <p style="color:rgba(255,255,255,0.82);line-height:1.7;margin-bottom:14px;">
              Jump straight to registration or a speaking inquiry.
            </p>
            <div style="display:grid;gap:10px;">
              <a
                href={routes.courses}
                style="display:inline-block;background:#c8102e;color:white;text-decoration:none;padding:10px 20px;border-radius:8px;font-weight:700;text-align:center;"
              >
                Find a Class
              </a>
              <a
                href={routes.speakingInquiry}
                style="display:inline-block;background:transparent;color:white;border:2px solid rgba(255,255,255,0.45);text-decoration:none;padding:8px 18px;border-radius:8px;font-weight:700;text-align:center;"
              >
                Book Judith to Speak
              </a>
              <a
                href={routes.emsa}
                style="display:inline-block;color:#f5a623;text-decoration:none;font-weight:600;text-align:center;"
              >
                EMSA course enrollment →
              </a>
            </div>
          </article>
        </aside>

        <article style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:28px;">
          <h2 style="font-size:1.3rem;color:#0f2744;margin-bottom:8px;">Send us a message</h2>
          <p style="color:#515154;line-height:1.7;margin-bottom:18px;">
            Complete the form and we will reply as soon as possible.
          </p>

          <form onsubmit="handleSubmit(event)">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label for="fullName" style="display:block;font-size:0.72rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:#86868B;margin-bottom:6px;">Full Name</label>
                <input
                  id="fullName"
                  type="text"
                  required
                  placeholder="Your full name"
                  style="width:100%;background:#f5f5f7;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;font-family:Poppins,sans-serif;font-size:0.92rem;"
                />
              </div>
              <div>
                <label for="phone" style="display:block;font-size:0.72rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:#86868B;margin-bottom:6px;">Phone Number</label>
                <input
                  id="phone"
                  type="tel"
                  required
                  placeholder="(323) 555-1234"
                  style="width:100%;background:#f5f5f7;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;font-family:Poppins,sans-serif;font-size:0.92rem;"
                />
              </div>
            </div>

            <div style="margin-top:12px;">
              <label for="email" style="display:block;font-size:0.72rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:#86868B;margin-bottom:6px;">Email</label>
              <input
                id="email"
                type="email"
                required
                placeholder="you@example.com"
                style="width:100%;background:#f5f5f7;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;font-family:Poppins,sans-serif;font-size:0.92rem;"
              />
            </div>

            <div style="margin-top:12px;">
              <label for="message" style="display:block;font-size:0.72rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:#86868B;margin-bottom:6px;">What can we help with?</label>
              <textarea
                id="message"
                required
                placeholder={defaultMessage}
                style="width:100%;height:140px;background:#f5f5f7;border:1px solid rgba(0,0,0,0.08);border-radius:10px;padding:12px 14px;font-family:Poppins,sans-serif;font-size:0.92rem;resize:vertical;"
              >{defaultMessage}</textarea>
            </div>

            <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden;">
              <label for="website">Website</label>
              <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <p
              id="contactFormStatus"
              role="status"
              aria-live="polite"
              style="min-height:1.25rem;margin-top:10px;font-size:0.88rem;color:#c8102e;"
            ></p>
            <button
              id="submitBtn"
              type="submit"
              style="width:100%;margin-top:4px;background:#0f2744;color:white;border:none;padding:14px;border-radius:8px;font-family:Poppins,sans-serif;font-size:0.95rem;font-weight:700;cursor:pointer;"
            >
              Send Message
            </button>
          </form>
        </article>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  @media (max-width: 800px) {
    .contact-shell > section > div:last-child {
      grid-template-columns: 1fr !important;
    }
  }
</style>
