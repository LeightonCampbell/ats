---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, routes } from "../lib/site";
---

<BaseLayout
  title="Keynote Speaking by Judith Morgan | Alert Training Services"
  description="Book Judith Morgan for keynote speaking and workplace safety presentations for conferences, corporate wellness events, and healthcare organizations."
  canonical={`${site.siteUrl}/speaking`}
>
  <main class="speak-page">
    <section class="speak-hero">
      <div class="wrap">
        <div class="eyebrow">Speaking &amp; Keynotes</div>
        <h1>Keynote Speaking &amp; Workplace Safety Presentations by {site.founder}</h1>
        <p class="sub">
          Empowering organizations with critical safety culture, emergency
          preparedness, and life-saving readiness.
        </p>
        <a class="btn-primary" href="#inquiry">Inquire About Judith&apos;s Availability</a>
      </div>
    </section>

    <section class="speak-body">
      <div class="wrap grid">
        <article>
          <h2>What organizers book Judith for</h2>
          <ul>
            <li>Interactive, memorable safety demonstrations and keynotes</li>
            <li>
              Tailored presentations for corporate retreats, healthcare summits,
              and education conferences
            </li>
            <li>
              Workplace readiness talks that connect clinical expertise with
              practical emergency response
            </li>
          </ul>
        </article>
        <aside class="planner">
          <h2>Meeting Planner Quick Info</h2>
          <p><strong>Direct contact:</strong> {site.founder}</p>
          <p>
            <a href={site.phoneHref}>{site.phone}</a>
            ·
            <a href={site.emailHref}>{site.email}</a>
          </p>
          <p class="muted">
            In-person (Los Angeles area and travel) or virtual engagements available.
          </p>
        </aside>
      </div>
    </section>

    <section class="speak-form-section" id="inquiry" aria-labelledby="inquiry-heading">
      <div class="wrap narrow">
        <h2 id="inquiry-heading">Inquire About Judith&apos;s Availability</h2>
        <p class="lead">
          Tell us about your event and we will follow up with availability and
          next steps.
        </p>

        <form class="speak-form" onsubmit="handleSpeakingSubmit(event)">
          <div class="row">
            <div>
              <label for="orgName">Organization / Event Name</label>
              <input id="orgName" name="orgName" type="text" required placeholder="Organization or event name" />
            </div>
            <div>
              <label for="fullName">Your Name</label>
              <input id="fullName" name="fullName" type="text" required placeholder="Full name" />
            </div>
          </div>
          <div class="row">
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required placeholder="you@organization.com" />
            </div>
            <div>
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" required placeholder="323-921-6244" />
            </div>
          </div>
          <div class="row">
            <div>
              <label for="eventDate">Event Date</label>
              <input id="eventDate" name="eventDate" type="text" required placeholder="Month / Day / Year or flexible" />
            </div>
            <div>
              <label for="locationType">Location</label>
              <select id="locationType" name="locationType" required>
                <option value="In-Person">In-Person</option>
                <option value="Virtual">Virtual</option>
                <option value="Hybrid / Undecided">Hybrid / Undecided</option>
              </select>
            </div>
          </div>
          <div>
            <label for="audienceSize">Estimated Audience Size</label>
            <input id="audienceSize" name="audienceSize" type="text" required placeholder="e.g. 50–100" />
          </div>
          <div>
            <label for="objectives">Target Topic / Objectives</label>
            <textarea
              id="objectives"
              name="objectives"
              required
              placeholder="What should the audience walk away knowing or feeling ready to do?"
            ></textarea>
          </div>
          <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden;">
            <label for="speak-website">Website</label>
            <input id="speak-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p id="speakFormStatus" role="status" aria-live="polite"></p>
          <button id="speakSubmitBtn" type="submit">Inquire About Judith&apos;s Availability</button>
        </form>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .speak-page {
    font-family: Poppins, -apple-system, BlinkMacSystemFont, sans-serif;
    background: #f5f5f7;
  }
  .wrap {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .narrow {
    max-width: 720px;
  }
  .speak-hero {
    padding: 56px 0 48px;
    background: linear-gradient(105deg, #0f2744, #1b3a5c);
    color: #fff;
  }
  .eyebrow {
    margin-bottom: 12px;
    color: #f5a623;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 14px;
    max-width: 820px;
    color: #fff;
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 1.18;
  }
  .sub {
    margin: 0 0 28px;
    max-width: 640px;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.7;
  }
  .btn-primary {
    display: inline-flex;
    padding: 13px 22px;
    border-radius: 8px;
    background: #c8102e;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .speak-body {
    padding: 48px 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 20px;
  }
  article,
  .planner {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 28px;
  }
  h2 {
    margin: 0 0 14px;
    color: #0f2744;
    font-size: 1.35rem;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    color: #515154;
    line-height: 1.8;
  }
  .planner p {
    margin: 0 0 10px;
    color: #515154;
    line-height: 1.6;
  }
  .planner a {
    color: #1b3a5c;
    font-weight: 600;
    text-decoration: none;
  }
  .muted {
    color: #86868b !important;
    font-size: 0.92rem;
  }
  .speak-form-section {
    padding: 0 0 64px;
  }
  .lead {
    margin: 0 0 22px;
    color: #515154;
    line-height: 1.7;
  }
  .speak-form {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 28px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .speak-form > div,
  .row > div {
    margin-bottom: 12px;
  }
  label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #86868b;
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    background: #f5f5f7;
    font: inherit;
    font-size: 0.92rem;
  }
  textarea {
    min-height: 120px;
    resize: vertical;
  }
  #speakFormStatus {
    min-height: 1.25rem;
    margin: 4px 0 8px;
    font-size: 0.88rem;
    color: #c8102e;
  }
  button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background: #0f2744;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  @media (max-width: 768px) {
    .grid,
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  async function handleSpeakingSubmit(event) {
    event.preventDefault();
    const status = document.getElementById("speakFormStatus");
    const btn = document.getElementById("speakSubmitBtn");
    const orgName = document.getElementById("orgName").value.trim();
    const fullName = document.getElementById("fullName").value.trim();
    const email = document.getElementById("email").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const eventDate = document.getElementById("eventDate").value.trim();
    const locationType = document.getElementById("locationType").value;
    const audienceSize = document.getElementById("audienceSize").value.trim();
    const objectives = document.getElementById("objectives").value.trim();

    const website = document.getElementById("speak-website")?.value?.trim() ?? "";
    const message = [
      "Speaking inquiry",
      `Organization / Event: ${orgName}`,
      `Event Date: ${eventDate}`,
      `Location: ${locationType}`,
      `Estimated Audience Size: ${audienceSize}`,
      `Target Topic / Objectives: ${objectives}`,
    ].join("\n");

    status.textContent = "";
    btn.disabled = true;
    btn.textContent = "Sending…";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          fullName,
          email,
          phone,
          message,
          website,
          subject: `Speaking inquiry: ${orgName}`,
        }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || "Unable to send inquiry.");
      }
      status.style.color = "#0f2744";
      status.textContent = "Thank you — your speaking inquiry was sent. We will be in touch soon.";
      event.target.reset();
    } catch (err) {
      status.style.color = "#c8102e";
      status.textContent = err.message || "Something went wrong. Please call 323-921-6244.";
    } finally {
      btn.disabled = false;
      btn.textContent = "Inquire About Judith's Availability";
    }
  }
  window.handleSpeakingSubmit = handleSpeakingSubmit;
</script>
