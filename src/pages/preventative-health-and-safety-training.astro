---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingWidget from "../components/BookingWidget.tsx";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import { getEnvAtRuntime } from "../lib/env";

const publishableKey = await getEnvAtRuntime("PUBLIC_STRIPE_PUBLISHABLE_KEY");
---

<BaseLayout
  title="Preventive Health & Safety with Nutrition and Lead Poisoning Prevention | Alert Training Services"
  description="Enroll in Alert Training Services' EMSA-approved Preventive Health & Safety with Nutrition and Lead Poisoning Prevention course. Monday and Tuesday evening sessions delivered online."
  canonical="https://www.alerttrainingservices.com/preventative-health-and-safety-training"
>
  <SiteHeader />
  <style>
    .booking-page {
      margin: 0 auto;
      font-family: Poppins, -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .booking-hero {
      text-align: center;
      margin-bottom: 40px;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }
    .booking-page-title {
      font-size: 2.2rem;
      font-weight: 700;
      color: #1b3a5c;
      letter-spacing: -0.03em;
      margin: 0 0 12px;
      line-height: 1.2;
    }
    .booking-page-title br,
    .booking-page-intro br {
      display: none;
    }
    .booking-page-intro {
      color: #515154;
      font-size: 1rem;
      line-height: 1.65;
      font-weight: 300;
      margin: 0;
    }
    @media (min-width: 640px) {
      .booking-hero {
        max-width: 44rem;
      }
      .booking-page-title {
        font-size: clamp(1.85rem, 2.4vw, 2.2rem);
      }
      .booking-page-intro {
        font-size: clamp(0.92rem, 1.15vw, 1rem);
      }
      .booking-page-title br,
      .booking-page-intro br {
        display: block;
      }
    }
    .booking-card-wrap {
      max-width: 560px;
      margin: 0 auto;
    }
  </style>
  <main
    class="booking-page"
    style="min-height:100vh; background:#f5f5f7; padding: 80px 24px;"
  >
      <div class="booking-hero">
          <div
            style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#E02B2B;margin-bottom:10px;"
          >
            Choose Upcoming Class
          </div>
          <h1 class="booking-page-title">
            Preventive Health &amp; Safety with Nutrition<br />
            and Lead Poisoning Prevention
          </h1>
          <p class="booking-page-intro">
            Classes are held on Mondays &amp; Tuesdays from 6 PM to 10 PM.<br />
            Select your Monday start date below - the matching Tuesday session is included for the same week.
          </p>
      </div>

      <div class="booking-card-wrap">
        <div
          style="background:white;border-radius:16px;border:1px solid rgba(0,0,0,0.08);padding:40px;"
        >
          <BookingWidget client:only="react" publishableKey={publishableKey} />
        </div>

        <p style="text-align:center;margin-top:20px;font-size:13px;color:#86868b;font-weight:300;">
          Payments secured by Stripe. Questions? Call <a
            href="tel:3239216244"
            style="color:#1B3A5C;">323-921-6244</a>
        </p>
      </div>
  </main>
  <SiteFooter />
  <script src="https://js.stripe.com/v3/" is:inline></script>
</BaseLayout>
