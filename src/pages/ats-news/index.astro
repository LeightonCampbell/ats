---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { blogPosts } from "../../data/blogPosts";
---

<BaseLayout
  title="ATS News & Resources | Alert Training Services"
  description="Articles and resources from Alert Training Services on California childcare safety training, daycare startup, and provider best practices."
  canonical="https://www.alerttrainingservices.com/ats-news"
>
  <SiteHeader />
  <style>
    .blog-shell section {
      padding: 0;
    }
  </style>
  <main class="blog-shell" style="background:#f5f5f7; padding: 50px 24px;">
    <section style="max-width:920px; margin:0 auto;">
      <div style="text-align:center; margin-bottom:34px;">
        <div
          style="font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#E02B2B;margin-bottom:10px;"
        >
          ATS News
        </div>
        <h1
          style="font-size:2.4rem;font-weight:700;color:#1B3A5C;letter-spacing:-0.03em;margin-bottom:12px;"
        >
          News & Resources
        </h1>
        <p
          style="max-width:760px;margin:0 auto;color:#515154;font-size:1rem;line-height:1.7;"
        >
          Practical guidance for California childcare providers — from EMSA
          training requirements to starting a home daycare.
        </p>
      </div>

      <div style="display:grid; gap:16px;">
        {
          blogPosts.map((post) => (
            <article
              style="background:white;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:28px;"
            >
              <div
                style="font-size:0.75rem;color:#86868b;margin-bottom:8px;"
              >
                {new Date(post.publishedAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}{" "}
                · {post.readTime}
              </div>
              <h2 style="font-size:1.35rem;color:#1B3A5C;margin-bottom:10px;">
                <a
                  href={`/ats-news/${post.slug}`}
                  style="color:inherit;text-decoration:none;"
                >
                  {post.title}
                </a>
              </h2>
              <p style="color:#515154;line-height:1.7;margin-bottom:16px;">
                {post.excerpt}
              </p>
              <a
                href={`/ats-news/${post.slug}`}
                style="color:#E02B2B;font-weight:600;text-decoration:none;"
              >
                Read article →
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
