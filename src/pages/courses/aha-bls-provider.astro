---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CourseInquiryForm from "../../components/CourseInquiryForm.astro";
import { site } from "../../lib/site";

const skills = [
  "High-Quality Adult, Child, and Infant CPR",
  "Automated External Defibrillator (AED) operation for all ages",
  "Effective Multi-Rescuer Team Response",
  "Foreign-body airway obstruction relief (choking emergencies)",
];

const audiences = [
  "Registered Nurses, LVNs, and nursing students",
  "Physicians and medical assistants",
  "EMTs, paramedics, and first responders",
  "Dental professionals and dental assistants",
  "Respiratory therapists",
  "Hospital, clinic, and emergency personnel",
  "Healthcare students requiring BLS certification",
];

const courseName = "AHA BLS Provider Course";
---

<BaseLayout
  title="AHA BLS Provider Course | Alert Training Services"
  description="In-person American Heart Association BLS Provider training with AHA course completion eCard. Hands-on CPR, AED, and team response instruction with Judith Morgan."
  canonical={`${site.siteUrl}/courses/aha-bls-provider`}
>
  <main class="course-page">
    <section class="course-hero">
      <div class="wrap">
        <div class="badge">American Heart Association (AHA) Certified</div>
        <h1>AHA BLS Provider Course</h1>
        <p class="format">
          In-Person, Hands-On Instruction · Individual &amp; Group sessions available
        </p>
        <p class="intro">
          Credential: AHA BLS Provider Course Completion eCard issued upon
          successful completion.
        </p>
        <div class="actions">
          <a class="btn-primary" href="#register">Register for an In-Person Class</a>
          <a class="btn-secondary" href="#register">Request On-Site Training at Your Facility</a>
        </div>
      </div>
    </section>

    <section class="course-body">
      <div class="wrap grid">
        <article>
          <h2>Core Skills Covered</h2>
          <ul>
            {skills.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h2>Who Needs This Course</h2>
          <ul>
            {audiences.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <CourseInquiryForm
      courseName={courseName}
      heading="Register for AHA BLS Provider"
      intro="Submit your registration or on-site training request below. We will confirm available class dates and next steps."
    />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .course-page {
    font-family: Poppins, -apple-system, BlinkMacSystemFont, sans-serif;
    background: #f5f5f7;
  }
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .course-hero {
    padding: 56px 0 48px;
    background: linear-gradient(105deg, #0f2744, #1b3a5c);
    color: #fff;
  }
  .badge {
    display: inline-block;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(245, 166, 35, 0.18);
    color: #f5a623;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.15;
    color: #fff;
  }
  .format {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
  }
  .intro {
    margin: 0;
    max-width: 680px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }
  .btn-primary {
    background: #c8102e;
    color: #fff;
  }
  .btn-secondary {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.55);
  }
  .course-body {
    padding: 48px 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  article {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 28px;
  }
  h2 {
    margin: 0 0 14px;
    color: #0f2744;
    font-size: 1.35rem;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    color: #515154;
    line-height: 1.8;
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
