---
import { routes } from "../lib/site";

const badges = [
  "Official AHA BLS Course Completion eCard",
  "Hands-On, In-Person Instruction",
  "On-Site Workplace Group Training Available",
];
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-eyebrow"><span class="ring"></span>AHA Training · Speaking · Workplace Readiness</div>
      <h1>Equipping Lifesavers. Inspiring Resilient Communities.</h1>
      <p class="hero-sub">
        Official American Heart Association (AHA) certified CPR &amp; emergency
        response training, plus dynamic keynote speaking by Judith Morgan.
      </p>
      <div class="hero-actions">
        <a href={routes.courses} class="hero-btn">View Upcoming Classes</a>
        <a href={`${routes.contact}?intent=speaking`} class="hero-link">
          <span class="tri" aria-hidden="true"></span>Inquire for Speaking &amp; Group Training
        </a>
      </div>
      <ul class="hero-badges">
        {badges.map((badge) => <li>{badge}</li>)}
      </ul>
    </div>
  </div>
</section>
