---
import { site, routes, footerQuickLinks, copyrightNotice } from "../lib/site";
---

<footer>
  <div class="footer-top">
    <div>
      <div class="f-brand-name">{site.legalName}</div>
      <div class="f-desc">{site.tagline}</div>
      <div class="f-contact">
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={site.emailHref}>{site.email}</a>
        <span>{site.domain}</span>
      </div>
    </div>
    <div class="f-col">
      <h5>Quick Links</h5>
      <ul>
        {
          footerQuickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li><a href={routes.about}>About Judith</a></li>
        <li><a href={routes.blog}>Blog</a></li>
        <li><a href={routes.classRules}>Class Rules</a></li>
      </ul>
    </div>
    <div class="f-col">
      <h5>Training Paths</h5>
      <ul>
        <li><a href={routes.bls}>Healthcare Providers (BLS)</a></li>
        <li><a href={routes.pediatric}>Caregivers (Pediatric CPR)</a></li>
        <li><a href={routes.emsa}>Childcare (EMSA Preventive)</a></li>
        <li><a href={routes.onsite}>Workplace Groups</a></li>
        <li><a href={routes.speaking}>Speaking &amp; Keynotes</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{copyrightNotice()}</span>
  </div>
</footer>

<style is:inline>
  .f-brand-name {
    margin-top: 10px;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
  }
</style>
