---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Alert Training Services | EMSA-Approved Safety Training in Los Angeles",
  description = "EMSA-approved Preventive Health and Safety training in Los Angeles. Evening online classes for California childcare providers.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --white: #ffffff;
        --offwhite: #fbfbfd;
        --gray-bg: #f5f5f7;
        --ink: #1d1d1f;
        --ink-soft: #6e6e73;
        --divider: #d2d2d7;
        --burgundy: #7a1d2e;
        --burgundy-dark: #5b1522;
        --navy: #1b3a5c;
        --navy-deep: #122844;
        --navy-pale: #eef2f7;
        --red: #e02b2b;
        --border: rgba(0, 0, 0, 0.08);
        --text: #1d1d1f;
        --text2: #515154;
        --text3: #86868b;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Inter",
          "Helvetica Neue",
          sans-serif;
        color: var(--ink);
        background: var(--white);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.06;
        margin: 0;
        color: var(--ink);
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      .wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
      }
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible {
        outline: 2px solid var(--burgundy);
        outline-offset: 3px;
      }

      /* ---------- old site header (logo + nav) ---------- */
      nav {
        position: sticky;
        top: 0;
        z-index: 200;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid var(--border);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 0 max(24px, 5vw);
        height: 72px;
      }
      .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .nav-brand img {
        height: 56px;
        width: auto;
        flex-shrink: 0;
        object-fit: contain;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        list-style: none;
        margin: 0;
        padding: 0;
        justify-self: center;
      }
      .nav-links > li {
        position: relative;
      }
      .nav-item-dropdown::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        height: 12px;
      }
      .nav-links a {
        font-size: 1.0625rem;
        font-weight: 500;
        color: var(--text2);
        text-decoration: none;
        transition: color 0.15s;
      }
      .nav-links a:hover {
        color: var(--navy);
      }
      .nav-submenu {
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        min-width: 280px;
        list-style: none;
        margin: 0;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 14px 36px rgba(18, 40, 68, 0.12);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity 0.15s ease,
          transform 0.15s ease;
        z-index: 220;
      }
      .nav-submenu a {
        display: block;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 0.8rem;
        color: var(--text2);
      }
      .nav-submenu a:hover {
        background: var(--navy-pale);
        color: var(--navy);
      }
      .nav-item-dropdown:hover .nav-submenu,
      .nav-item-dropdown:focus-within .nav-submenu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
      }
      .nav-btn {
        background: var(--burgundy);
        color: var(--white) !important;
        text-decoration: none !important;
        padding: 11px 24px;
        border-radius: 980px;
        font-size: 1.0625rem !important;
        font-weight: 600 !important;
        transition: background 0.15s !important;
      }
      .nav-btn:hover {
        background: var(--burgundy-dark) !important;
      }
      .nav-cta {
        justify-self: end;
      }
      .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
      }
      .hamburger span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--navy);
        border-radius: 2px;
      }
      .mobile-menu {
        display: none;
        flex-direction: column;
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(20px);
        padding: 32px 28px;
        z-index: 199;
        overflow-y: auto;
      }
      .mobile-menu.open {
        display: flex;
      }
      .mobile-menu a {
        color: var(--text);
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .mob-enroll {
        margin-top: 24px;
        background: var(--navy);
        color: var(--white) !important;
        text-align: center;
        padding: 16px !important;
        border-radius: 14px;
        font-weight: 700 !important;
        border: none !important;
      }
      .mob-phone {
        color: var(--red) !important;
        border-bottom: none !important;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 11px 22px;
        border-radius: 980px;
        font-weight: 500;
        font-size: 0.9rem;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: opacity 0.15s ease;
      }
      .btn:hover {
        opacity: 0.82;
      }
      .btn-primary {
        background: var(--ink);
        color: var(--white);
      }
      .btn-outline {
        background: transparent;
        color: var(--ink);
        border-color: var(--divider);
      }
      .btn-outline:hover {
        border-color: var(--ink);
        opacity: 1;
      }
      .btn-accent {
        background: var(--burgundy);
        color: var(--white);
      }
      .btn-small {
        padding: 7px 16px;
        font-size: 0.8rem;
      }

      .hero {
        padding: 96px 0 64px;
        text-align: center;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--ink-soft);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 20px;
      }
      .eyebrow .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--burgundy);
      }
      .hero h1 {
        font-size: clamp(2.4rem, 5vw, 4rem);
        max-width: 15ch;
        margin: 0 auto;
      }
      .hero .sub {
        margin: 22px auto 0;
        font-size: 1.25rem;
        color: var(--ink-soft);
        max-width: 42ch;
        font-weight: 400;
        letter-spacing: -0.005em;
      }
      .hero-ctas {
        display: flex;
        justify-content: center;
        gap: 14px;
        margin-top: 34px;
        flex-wrap: wrap;
      }
      .hero-note {
        margin-top: 22px;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      .mockup-band {
        background: var(--gray-bg);
        padding: 64px 0 88px;
      }
      .device {
        max-width: 760px;
        margin: 0 auto;
        background: var(--ink);
        border-radius: 22px;
        padding: 14px;
        box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.28);
      }
      .device-screen {
        background: var(--white);
        border-radius: 12px;
        padding: 36px 40px;
      }
      .device-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 22px;
      }
      .device-head h3 {
        font-size: 1rem;
        font-weight: 600;
      }
      .device-head span {
        font-size: 0.78rem;
        color: var(--ink-soft);
      }
      .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
      }
      .cal-cell {
        border-radius: 10px;
        padding: 12px 6px;
        text-align: center;
        background: var(--gray-bg);
      }
      .cal-cell .day {
        font-size: 0.7rem;
        color: var(--ink-soft);
        font-weight: 600;
      }
      .cal-cell .time {
        font-size: 0.7rem;
        color: var(--ink-soft);
        margin-top: 6px;
      }
      .cal-cell.active {
        background: var(--burgundy);
      }
      .cal-cell.active .day,
      .cal-cell.active .time {
        color: #f3d9dd;
      }
      .cal-cell.active .time {
        color: var(--white);
        font-weight: 600;
      }
      .device-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--divider);
      }
      .device-foot .label {
        font-size: 0.78rem;
        color: var(--ink-soft);
      }
      .device-foot .value {
        font-weight: 700;
        font-size: 1.05rem;
      }

      .stats {
        padding: 72px 0;
      }
      .stat-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        text-align: center;
      }
      .stat {
        padding: 0 20px;
        border-left: 1px solid var(--divider);
      }
      .stat:first-child {
        border-left: none;
      }
      .stat .num {
        font-size: clamp(2.2rem, 4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .stat .lbl {
        margin-top: 8px;
        color: var(--ink-soft);
        font-size: 0.92rem;
      }

      .feature {
        padding: 96px 0;
      }
      .feature.gray {
        background: var(--gray-bg);
      }
      .feature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: center;
      }
      .feature-grid.reverse .feature-visual {
        order: 2;
      }
      .feature h2 {
        font-size: clamp(1.9rem, 3.2vw, 2.5rem);
        max-width: 14ch;
      }
      .feature p {
        margin-top: 16px;
        font-size: 1.08rem;
        color: var(--ink-soft);
        max-width: 40ch;
      }
      .feature-visual {
        background: var(--white);
        border-radius: 20px;
        padding: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 260px;
        border: 1px solid var(--divider);
      }
      .feature.gray .feature-visual {
        background: var(--white);
      }
      .feature-visual svg {
        width: 120px;
        height: 120px;
      }
      .feature-visual svg path,
      .feature-visual svg circle,
      .feature-visual svg rect,
      .feature-visual svg line {
        stroke: var(--ink);
      }

      .checklist-section {
        padding: 88px 0;
      }
      .checklist-head {
        text-align: center;
        max-width: 560px;
        margin: 0 auto 52px;
      }
      .checklist-head h2 {
        font-size: clamp(1.9rem, 3vw, 2.4rem);
      }
      .checklist-head p {
        margin-top: 14px;
        color: var(--ink-soft);
        font-size: 1.05rem;
      }
      .checklist-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px 48px;
        max-width: 820px;
        margin: 0 auto;
      }
      .check-item {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--divider);
      }
      .check-item svg {
        width: 18px;
        height: 18px;
        flex: none;
        margin-top: 3px;
      }
      .check-item svg path {
        fill: var(--burgundy);
      }
      .check-item span {
        font-size: 0.98rem;
        font-weight: 500;
      }

      .serve {
        padding: 80px 0;
        text-align: center;
      }
      .serve-head {
        max-width: 560px;
        margin: 0 auto 40px;
      }
      .serve-head h2 {
        font-size: clamp(1.9rem, 3vw, 2.4rem);
      }
      .serve-head p {
        margin-top: 14px;
        color: var(--ink-soft);
        font-size: 1.05rem;
      }
      .serve-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }
      .serve-chip {
        border: 1px solid var(--divider);
        border-radius: 980px;
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--ink);
      }

      .instructor {
        background: var(--gray-bg);
        padding: 96px 0;
        text-align: center;
      }
      .avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: var(--ink);
        color: var(--white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.6rem;
        margin: 0 auto 16px;
      }
      .instructor h3 {
        font-size: 1.3rem;
      }
      .instructor .role {
        color: var(--ink-soft);
        margin-top: 4px;
        font-size: 0.92rem;
      }
      .stars {
        color: var(--burgundy);
        letter-spacing: 3px;
        margin-top: 8px;
        font-size: 1rem;
      }
      .quotes {
        max-width: 680px;
        margin: 56px auto 0;
        display: flex;
        flex-direction: column;
        gap: 36px;
      }
      .quote p {
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: -0.005em;
        line-height: 1.4;
      }
      .quote .attr {
        margin-top: 14px;
        color: var(--ink-soft);
        font-size: 0.9rem;
      }

      .closing {
        padding: 110px 0;
        text-align: center;
      }
      .closing h2 {
        font-size: clamp(2rem, 3.6vw, 2.8rem);
        max-width: 16ch;
        margin: 0 auto;
      }
      .closing p {
        margin: 16px auto 0;
        color: var(--ink-soft);
        font-size: 1.1rem;
        max-width: 42ch;
      }
      .closing .hero-ctas {
        margin-top: 32px;
      }

      .faq {
        padding: 88px 0;
      }
      .faq-head {
        text-align: center;
        margin-bottom: 44px;
      }
      .faq-head h2 {
        font-size: clamp(1.9rem, 3vw, 2.4rem);
      }
      .faq-list {
        max-width: 680px;
        margin: 0 auto;
      }
      details {
        border-bottom: 1px solid var(--divider);
        padding: 4px 0;
      }
      summary {
        cursor: pointer;
        font-weight: 600;
        padding: 18px 4px;
        font-size: 1rem;
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      summary::-webkit-details-marker {
        display: none;
      }
      summary .plus {
        font-size: 1.3rem;
        color: var(--ink-soft);
        font-weight: 300;
        transition: transform 0.2s ease;
      }
      details[open] summary .plus {
        transform: rotate(45deg);
      }
      details p {
        margin: 0 0 18px 4px;
        color: var(--ink-soft);
        max-width: 60ch;
      }

      footer {
        background: var(--navy-deep);
        color: rgba(255, 255, 255, 0.4);
        padding: 56px max(24px, 5vw) 32px;
      }
      .footer-top {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 48px;
        padding-bottom: 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .f-logo {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
      }
      .f-logo img {
        height: 44px;
        width: auto;
        object-fit: contain;
      }
      .f-desc {
        font-size: 0.83rem;
        line-height: 1.7;
      }
      .f-contact {
        margin-top: 14px;
        font-size: 0.8rem;
      }
      .f-contact a {
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        display: block;
        margin-bottom: 3px;
      }
      .f-contact a:hover {
        color: var(--white);
      }
      .f-col h5 {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--white);
        margin-bottom: 16px;
      }
      .f-col ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
      }
      .f-col a {
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        font-size: 0.83rem;
        transition: color 0.15s;
      }
      .f-col a:hover {
        color: var(--white);
      }
      .footer-bottom {
        margin-top: 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.76rem;
        flex-wrap: wrap;
        gap: 8px;
      }

      @media (max-width: 900px) {
        nav {
          display: flex;
          justify-content: space-between;
        }
        .nav-links,
        .nav-cta {
          display: none;
        }
        .hamburger {
          display: flex;
        }
        .feature-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .feature-grid.reverse .feature-visual {
          order: 0;
        }
        .stat-row {
          grid-template-columns: 1fr;
          gap: 28px;
        }
        .stat {
          border-left: none;
          border-top: 1px solid var(--divider);
          padding-top: 24px;
        }
        .stat:first-child {
          border-top: none;
          padding-top: 0;
        }
        .checklist-grid {
          grid-template-columns: 1fr;
        }
        .footer-top {
          grid-template-columns: 1fr;
          gap: 32px;
        }
        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }
        .cal-grid {
          grid-template-columns: repeat(7, 1fr);
          gap: 4px;
        }
        .cal-cell {
          padding: 8px 2px;
        }
        .cal-cell .day,
        .cal-cell .time {
          font-size: 0.6rem;
        }
      }
      @media (max-width: 520px) {
        .device-screen {
          padding: 22px 16px;
        }
        .hero {
          padding: 72px 0 48px;
        }
        .feature,
        .checklist-section,
        .serve,
        .instructor,
        .closing,
        .faq {
          padding: 64px 0;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <script is:inline>
      function toggleMenu() {
        document.getElementById("mobileMenu")?.classList.toggle("open");
      }
      function closeMenu() {
        document.getElementById("mobileMenu")?.classList.remove("open");
      }
      window.toggleMenu = toggleMenu;
      window.closeMenu = closeMenu;
    </script>
  </body>
</html>
