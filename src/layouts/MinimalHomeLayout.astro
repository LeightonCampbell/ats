---
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Alert Training Services | AHA CPR Training & Judith Morgan Speaking",
  description = "Official American Heart Association CPR training, EMSA Preventive Health & Safety courses, and keynote speaking by Judith Morgan.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/images/hero-online-training.webp" />
    <style is:global>
      :root {
        --white: #ffffff;
        --offwhite: #fbfbfd;
        --gray-bg: #f5f5f7;
        --ink: #1d1d1f;
        --ink-soft: #6e6e73;
        --divider: #d2d2d7;
        --navy: #0f2744;
        --slate: #1b3a5c;
        --navy-deep: #0a1a2e;
        --navy-pale: #eef2f7;
        --accent: #c8102e;
        --accent-dark: #a00d25;
        --amber: #f5a623;
        --burgundy: #c8102e;
        --burgundy-dark: #a00d25;
        --red: #c8102e;
        --border: rgba(0, 0, 0, 0.08);
        --text: #1d1d1f;
        --text2: #515154;
        --text3: #86868b;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Inter",
          "Helvetica Neue",
          sans-serif;
        color: var(--ink);
        background: var(--white);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.06;
        margin: 0;
        color: var(--ink);
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      .wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
      }
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible {
        outline: 2px solid var(--burgundy);
        outline-offset: 3px;
      }

      /* Header chrome lives in SiteHeader.astro */

      .hero {
        position: relative;
        display: flex;
        align-items: center;
        min-height: min(780px, 90vh);
        padding: calc(var(--hdr-height, 88px) + 48px) 0 88px;
        overflow: hidden;
        color: #ffffff;
        font-family: "Poppins", -apple-system, BlinkMacSystemFont, sans-serif;
        background:
          linear-gradient(
            105deg,
            rgba(15, 39, 68, 0.96) 0%,
            rgba(27, 58, 92, 0.9) 42%,
            rgba(27, 58, 92, 0.55) 70%,
            rgba(15, 39, 68, 0.35) 100%
          ),
          url("/images/hero-online-training.webp") right center / cover no-repeat var(--navy);
      }
      .hero-inner {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }
      .hero-copy {
        max-width: 680px;
      }
      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .hero-eyebrow .ring {
        width: 10px;
        height: 10px;
        border: 3px solid var(--amber);
        border-radius: 50%;
        box-sizing: border-box;
      }
      .hero h1 {
        margin: 0;
        color: #ffffff;
        font-family: inherit;
        font-size: clamp(2.35rem, 4.8vw, 3.6rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }
      .hero-sub {
        max-width: 560px;
        margin: 22px 0 0;
        color: rgba(255, 255, 255, 0.92);
        font-size: 1.05rem;
        line-height: 1.7;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 22px;
        margin-top: 32px;
      }
      .hero-btn {
        display: inline-flex;
        align-items: center;
        padding: 14px 28px;
        border-radius: 8px;
        background: var(--accent);
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.15s;
      }
      .hero-btn:hover {
        background: var(--accent-dark);
      }
      .hero-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition: opacity 0.15s;
      }
      .hero-link:hover {
        opacity: 0.8;
      }
      .hero-link .tri {
        width: 0;
        height: 0;
        border-top: 5px solid transparent;
        border-bottom: 5px solid transparent;
        border-left: 7px solid currentColor;
      }
      .hero-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        list-style: none;
        margin: 36px 0 0;
        padding: 0;
      }
      .hero-badges li {
        padding: 8px 14px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.95);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.3;
      }
      @media (max-width: 900px) {
        .hero {
          min-height: 0;
          padding: calc(var(--hdr-height, 76px) + 40px) 0 64px;
          text-align: center;
          background:
            linear-gradient(
              180deg,
              rgba(15, 39, 68, 0.97) 0%,
              rgba(27, 58, 92, 0.92) 100%
            ),
            url("/images/hero-online-training.webp") center 30% / cover no-repeat var(--navy);
        }
        .hero-copy {
          max-width: 640px;
          margin: 0 auto;
        }
        .hero-eyebrow {
          justify-content: center;
        }
        .hero-sub {
          max-width: 36rem;
          margin-left: auto;
          margin-right: auto;
        }
        .hero-actions {
          justify-content: center;
        }
        .hero-badges {
          justify-content: center;
        }
      }
      @media (max-width: 560px) {
        .hero {
          padding: calc(var(--hdr-height, 76px) + 32px) 0 56px;
        }
        .hero h1 {
          font-size: clamp(1.85rem, 8vw, 2.4rem);
        }
        .hero-actions {
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
        }
        .hero-btn,
        .hero-link {
          justify-content: center;
          width: 100%;
        }
        .hero-badges {
          gap: 8px;
        }
        .hero-badges li {
          font-size: 0.72rem;
        }
      }
    </style>
  </head>
  <body>
    <SiteHeader overlay />
    <slot />
  </body>
</html>
